#!/usr/bin/env bash
set -euo pipefail
self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd "$(dirname "$self")/.." && pwd)
config_root=${XDG_CONFIG_HOME:-$HOME/.config}
install_dir=$config_root/kay-cast
runtime=$repo/shell.qml
service=$config_root/systemd/user/kay-cast.service
cli_link=$HOME/.local/bin/kay-cast
fail() { printf 'kay-cast: %s\n' "$*" >&2; exit 1; }
need_qs() { command -v qs >/dev/null || fail 'Install quickshell first (sudo pacman -S quickshell)'; }
ipc() { qs ipc -p "$runtime" call -- kay-cast "$@"; }
owned_service() { [[ -f $service ]] && grep -q '^# Managed by kay-cast$' "$service"; }
start() {
  need_qs
  if [[ $(ipc ping 2>/dev/null) == ok ]]; then return; fi
  if owned_service; then systemctl --user start kay-cast.service
  else qs -d -n -p "$runtime"; fi
  for ((i=0; i<50; i++)); do
    if [[ $(ipc ping 2>/dev/null) == ok ]]; then return; fi
    sleep 0.1
  done
  fail "Launcher did not start; inspect: qs log -n -p '$runtime'"
}
link_owned() {
  local target=$1 dest=$2
  if [[ -e $dest || -L $dest ]]; then
    [[ -L $dest && $(readlink -f "$dest") == "$target" ]] || fail "Refusing to replace $dest"
  fi
  ln -sfn "$target" "$dest"
}
install() {
  need_qs
  if [[ -e $service ]] && ! owned_service; then fail "Refusing to replace $service"; fi
  mkdir -p "$install_dir" "$HOME/.local/bin" "$(dirname "$service")"
  link_owned "$repo" "$install_dir/runtime"
  link_owned "$self" "$cli_link"
  # Quote systemd paths, escape specifiers, and reject unsupported line breaks.
  local qs_bin escaped_runtime escaped_config
  qs_bin=$(command -v qs)
  [[ $runtime != *$'\n'* && $runtime != *'"'* && $runtime != *'\\'* ]] || fail 'Unsupported characters in checkout path'
  escaped_runtime=${runtime//%/%%}
  escaped_config=${config_root//%/%%}
  cat > "$service" <<UNIT
# Managed by kay-cast
[Unit]
Description=kay-cast CachyOS launcher
PartOf=graphical-session.target
After=graphical-session.target
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
ExecStart="$qs_bin" -n -p "$escaped_runtime"
Restart=always
RestartSec=4
Environment="XDG_CONFIG_HOME=$escaped_config"
EnvironmentFile=-$escaped_config/kay-cast/environment

[Install]
WantedBy=graphical-session.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable kay-cast.service
  # Hyprland's graphical session usually imports these; also support plain exec-once sessions.
  for name in PATH WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; do
    [[ -z ${!name:-} ]] || systemctl --user import-environment "$name"
  done
  systemctl --user stop kay-cast.service
  qs kill -p "$runtime" >/dev/null 2>&1 || true
  for ((i=0; i<50; i++)); do
    [[ $(ipc ping 2>/dev/null) == ok ]] || break
    sleep 0.1
  done
  systemctl --user start kay-cast.service
  start
  printf 'Installed standalone launcher. Bind Alt+Space: kay-cast setup hyprland\n'
}
uninstall() {
  if owned_service; then
    systemctl --user disable --now kay-cast.service
    rm -- "$service"
    systemctl --user daemon-reload
  else qs kill -p "$runtime" 2>/dev/null || true; fi
  for path in "$cli_link" "$install_dir/runtime"; do
    if [[ -L $path ]]; then
      target=$(readlink -f "$path")
      [[ $target != "$self" && $target != "$repo" ]] || rm -- "$path"
    fi
  done
  python3 "$repo/bin/kay-cast-hyprland.py" uninstall
  printf 'Uninstalled. Settings, commands and history are preserved.\n'
}
reload() {
  need_qs
  if owned_service; then systemctl --user restart kay-cast.service; start
  else
    qs kill -p "$runtime" 2>/dev/null || true
    for ((i=0; i<50; i++)); do
      if [[ $(ipc ping 2>/dev/null) != ok ]]; then break; fi
      sleep 0.1
    done
    start
  fi
}
doctor() {
  local bad=0
  check() { if "$@" >/dev/null 2>&1; then printf '  ok    %s\n' "$*"; else printf '  FAIL  %s\n' "$*"; bad=1; fi; }
  check command -v qs
  check hyprctl version
  ping_ok() { [[ $(ipc ping) == ok ]]; }
  health_ok() { [[ $(ipc call system.healthPing '{}') == '{"ok":true,"data":null}' ]]; }
  ready_ok() { [[ $(ipc call system.info '{}') == *'"ready":true'* ]]; }
  check ping_ok
  check health_ok
  check ready_ok
  for tool in xdg-open wl-copy notify-send; do check command -v "$tool"; done
  [[ -f $config_root/kmdot/quickshell/Colors.qml ]] && echo '  ok    kmDot generated palette' || echo '  info  kmDot palette missing; using Tokyo Night fallback'
  [[ ! -x $config_root/kmdot/quickshell/scripts/toggle.sh ]] || echo '  ok    kmDot launcher integration'
  owned_service && check systemctl --user is-active kay-cast.service
  if ! command -v wtype >/dev/null; then echo '  info  wtype missing; Paste Answer unavailable (Copy Answer works)'; fi
  if ! "$repo/bin/kay-cast-desktop" agent-check; then echo '  info  configure agent/terminal in ~/.config/kay-cast/environment'; fi
  return "$bad"
}
usage() {
  cat <<'USAGE'
Usage: kay-cast <command> [args]
  toggle | show | hide        Control the standalone launcher
  start | stop | reload       Manage only this Quickshell instance
  run <commandId>             Run a command
  call <method> [json]        Call a backend RPC method
  ping | doctor              Inspect runtime health
  install | uninstall        Manage CLI link and user session service
  setup hyprland             Add Alt+Space without replacing kmDot bindings
  dev                        Reload on source changes (inotify-tools)
USAGE
}
case ${1:-help} in
  toggle|show) start; ipc "$1" ;;
  hide|ping) need_qs; ipc "$1" ;;
  start) start ;;
  stop) if owned_service; then systemctl --user stop kay-cast.service; else qs kill -p "$runtime"; fi ;;
  run) [[ -n ${2:-} ]] || fail 'usage: kay-cast run <commandId>'; start; ipc run "$2" ;;
  call) [[ -n ${2:-} ]] || fail 'usage: kay-cast call <method> [json]'; need_qs; ipc call "$2" "${3:-}" ;;
  install) install ;;
  uninstall) uninstall ;;
  reload) reload ;;
  doctor) doctor ;;
  setup) [[ ${2:-} == hyprland ]] || fail 'usage: kay-cast setup hyprland'; python3 "$repo/bin/kay-cast-hyprland.py" setup ;;
  dev)
    command -v inotifywait >/dev/null || fail 'Install inotify-tools for dev'
    reload
    while inotifywait -q -r -e close_write,create,delete,move "$repo/plugin" "$runtime"; do reload; done
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
